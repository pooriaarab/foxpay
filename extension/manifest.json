{
  "manifest_version": 3,
  "name": "foxpay demo",
  "version": "0.1.0",
  "description": "Agent payments with spend caps and approval for each payment.",
  "browser_specific_settings": {
    "gecko": {
      "id": "foxpay@pooriaarab",
      "strict_min_version": "153.0",
      "data_collection_permissions": {
        "required": ["financialAndPaymentInfo"]
      }
    }
  },
  "permissions": ["storage", "publicSuffix", "scripting", "webNavigation"],
  "host_permissions": ["http://localhost/*", "http://*.localhost/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "foxpay demo",
    "default_popup": "popup.html"
  }
}
